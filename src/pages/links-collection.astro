---
import Layout from "../layouts/Layout.astro";
import Links from "../components/Links.astro";
---

<Layout title="links-collection">
  <h1>Links Collection</h1>
  <p>Here's a bunch of links I want to keep warm and close for ease to come back to it to re-read and share.</p>
  <div class="bulleted-list mb-6">
    <ul>
      <li>
        <Links url="https://jakearchibald.com/2021/great-alt-text/">Writing great alt text: Emotion matters</Links> - by Jake Archibald
      </li>
      <li>
        <Links url="https://jakearchibald.com/2023/against-self-closing-tags-in-html/">A History of the web and self-closing tags</Links> - by Jake Archibald
      </li>
      <li>
        <Links url="https://simonhearne.com/2022/survorship-bias-in-webperf/">Survivor bias in web performance</Links> - by Simon Hearne
      </li>
    </ul>
  </div>
</Layout>